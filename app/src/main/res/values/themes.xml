<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BlenderRemote" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Rounded, translucent button used everywhere in the overlay -->
    <style name="BR.Button" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">@color/glass_light</item>
    </style>

    <style name="BR.Button.Record">
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">32dp</item>
        <item name="backgroundTint">@color/record_red</item>
    </style>

    <style name="BR.Label" parent="">
        <item name="android:textColor">#B0FFFFFF</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">52dp</item>
    </style>
</resources>
